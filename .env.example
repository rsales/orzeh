# Token de Preview (rascunho) ou Public (publicado) do seu Space
# Settings → Access Tokens, no painel da Storyblok
STORYBLOK_DELIVERY_API_TOKEN=

# Região do Space: eu, us, cn, ap ou ca (Settings → General)
STORYBLOK_REGION=eu

# Opcional — só necessário se o space foi criado via Storyblok Blueprints
# STORYBLOK_API_BASE_URL=https://api.storyblok.com
